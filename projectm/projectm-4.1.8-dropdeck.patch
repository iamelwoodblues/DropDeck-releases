+
+void ProjectM::DrawInitialImage(uint32_t textureId, int width, int height)
+{
+    if (!m_activePreset || textureId == 0 || width <= 0 || height <= 0)
+    {
+        return;
+    }
+    auto image = std::make_shared<Renderer::Texture>("seed", textureId, GL_TEXTURE_2D, width, height, false);
+    m_activePreset->DrawInitialImage(image, GetRenderContext());
+}
+
+auto ProjectM::FeedbackTexture(int* width, int* height) const -> uint32_t
+{
+    if (!m_activePreset)
+    {
+        return 0;
+    }
+    auto texture = m_activePreset->FeedbackTexture();
+    if (!texture || texture->Empty())
+    {
+        return 0;
+    }
+    if (width)
+    {
+        *width = texture->Width();
+    }
+    if (height)
+    {
+        *height = texture->Height();
+    }
+    return texture->TextureID();
+}
